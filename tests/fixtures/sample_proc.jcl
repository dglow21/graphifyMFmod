//BATCHRUN JOB (ACCT),'NIGHTLY',CLASS=A,MSGCLASS=X
//*  Defines an in-stream procedure, then invokes it.
//LOADPROC PROC
//PLOAD    EXEC PGM=LOADER
//SYSUT1   DD DSN=PROD.STAGING.DATA,DISP=SHR
//PVERIFY  EXEC PGM=VERIFY
//         PEND
//RUNLOAD  EXEC LOADPROC
//AUDIT    DD DSN=PROD.AUDIT.LOG,
//            DISP=(MOD,KEEP)
//REPORT   EXEC PGM=RPTGEN
//RPTOUT   DD DSN=PROD.REPORTS.DAILY,DISP=(NEW,CATLG)
